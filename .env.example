# Public URL of this portal (no trailing slash). Used to register Shopify webhooks.
APP_URL=https://seller.lbeauty.org

# Existing Shopify Admin API configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternatively, use SHOPIFY_ADMIN_ACCESS_TOKEN instead of client credentials.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional if different from SHOPIFY_CLIENT_SECRET. Signs Shopify webhook requests.
SHOPIFY_WEBHOOK_SECRET=

# Resend email delivery (https://resend.com)
RESEND_API_KEY=
# The sender's domain must be verified in Resend.
EMAIL_FROM="Latinas in Beauty <orders@your-verified-domain.com>"

JWT_SECRET=
PORT=5000
